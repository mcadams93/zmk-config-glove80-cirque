#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/gpio/gpio.h>

&spi0 {
    status = "okay";
    
    /* Native hardware Chip Select mapped cleanly onto the XIAO pin layout */
    cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>; // CS line linked to Seeed Studio D2

    trackpad: pinnacle@0 {
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";
        
        /* Zephyr 4.1 Official Core Upstream Parameters */
        data-ready-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>; // DR line linked to Seeed Studio D3
        sensitivity = "2x";
        sleep-mode-enable;
        
        /* Flags the hardware controller to forward raw coordinate maps */
        absolute-mode;
    };
};

/ {
    /* Step 1: Forward absolute touch variables to halfdane gesture calculations */
    trackpad_gestures: trackpad_gestures {
        compatible = "halfdane,zmk-input-gestures";
        device = <&trackpad>;

        /* Surface Click Mapping */
        tap-to-click;
        double-tap-to-click;
        
        /* Corner Right-Click Quadrant Definition */
        right-click-zone;
        right-click-zone-min-x = <70>;  
        right-click-zone-max-y = <30>;  

        /* Circular Perimeter Rim Scrolling Map */
        circular-scroll;
        circular-scroll-rim-percent = <12>; 
        circular-scroll-width = <1024>;    
        circular-scroll-height = <1024>;
    };

    /* Step 2: Stream completed actions straight back to ZMK mouse engine nodes */
    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad_gestures>;
    };
};
