#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/gpio/gpio.h>

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,  // SCK -> XIAO Pin D5
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>, // MOSI -> XIAO Pin D10
                    <NRF_PSEL(SPIM_MISO, 0, 9)>;  // MISO -> XIAO Pin D9
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 10)>,
                    <NRF_PSEL(TWIM_MISO, 0, 9)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* SPI Chip Select Line */
    cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>; // CS -> XIAO Pin D2

    trackpad: pinnacle@0 {
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";
        
        /* Official ZMK Driver property name for SPI Data Ready Interrupt line */
        dr-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>; // DR -> XIAO Pin D3
        
        sensitivity = "2x";                     // Speed modifier (1x to 4x)
    };
};

/ {
    /* Define gesture zones, taps, and circular thresholds */
    trackpad_gestures: trackpad_gestures {
        compatible = "halfdane,zmk-input-gestures";
        device = <&trackpad>;

        /* Tap Actions */
        tap-to-click;
        double-tap-to-click;
        
        /* Bottom-Right Right Click Quadrant */
        right-click-zone;
        right-click-zone-min-x = <70>;  
        right-click-zone-max-y = <30>;  

        /* Circular Rim Scrolling */
        circular-scroll;
        circular-scroll-rim-percent = <12>; 
        circular-scroll-width = <1024>;    
        circular-scroll-height = <1024>;
    };

    /* Pipe processed gestures into standard mouse events */
    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad_gestures>;
    };
};
